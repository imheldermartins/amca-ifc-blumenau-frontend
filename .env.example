# Conexão direta com o backend Express (opcional).
#
# No desenvolvimento local padrão, não é preciso criar .env: o frontend usa
# /api/v1 e /socket.io na própria origem, e o proxy do Vite encaminha ambos para
# http://localhost:3000.
#
# Copie este arquivo para .env somente para ignorar o proxy e falar direto com
# outra instância. Informe a base URL completa da API, incluindo a versão.
VITE_CUBS_API_URL=http://localhost:3000/api/v1

# Hoje o socket.io está no mesmo servidor e herda somente a origem da URL acima.
# Só defina esta variável se ele for separado da API.
# VITE_CUBS_SOCKET_URL=http://localhost:3000
