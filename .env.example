# Conexão direta com o backend Express (opcional).
#
# No desenvolvimento local padrão, não é preciso criar .env: o frontend usa
# /api e /socket.io na própria origem, e o proxy do Vite encaminha ambos para
# http://localhost:3000.
#
# Copie este arquivo para .env somente para ignorar o proxy e falar direto com
# outra instância. Informe só a origem, sem /api.
VITE_CUBS_API_URL=http://localhost:3000

# Hoje o socket.io está no mesmo servidor e herda a URL acima. Só defina esta
# variável se ele for separado da API.
# VITE_CUBS_SOCKET_URL=http://localhost:3000
